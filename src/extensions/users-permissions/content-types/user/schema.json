{
  "kind": "collectionType",
  "collectionName": "users-permissions_user",
  "info": {
    "singularName": "user",
    "pluralName": "users",
    "displayName": "user"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "username": {
      "type": "string",
      "required": true,
      "unique": true,
      "minLength": 3
    },
    "email": {
      "type": "email",
      "required": true,
      "minLength": 6
    },
    "provider": {
      "type": "string"
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "private": true
    },
    "resetPasswordToken": {
      "type": "string",
      "private": true
    },
    "confirmationToken": {
      "type": "string",
      "private": true
    },
    "confirmed": {
      "type": "boolean",
      "default": false
    },
    "blocked": {
      "type": "boolean",
      "default": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "hidden": {
      "type": "boolean",
      "default": false
    },
    "daily_dedications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::daily-dedication.daily-dedication",
      "mappedBy": "users_permissions_user"
    },
    "cost_by_hour": {
      "type": "decimal"
    },
    "monthly_salary": {
      "type": "decimal"
    },
    "monthly_tax": {
      "type": "decimal"
    },
    "tasks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::task.task",
      "mappedBy": "users_permissions_users"
    },
    "ical": {
      "type": "string"
    },
    "excel_decimal": {
      "type": "string",
      "maxLength": 1
    },
    "fullname": {
      "type": "string"
    },
    "permissions": {
      "type": "component",
      "repeatable": true,
      "component": "permissions.application-permission"
    },
    "identity_number": {
      "type": "string"
    },
    "naf": {
      "type": "string"
    },
    "multidelivery_discount": {
      "type": "boolean"
    }
  }
}
