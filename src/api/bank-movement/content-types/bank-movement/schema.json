{
  "kind": "collectionType",
  "collectionName": "bank_movements",
  "info": {
    "singularName": "bank-movement",
    "pluralName": "bank-movements",
    "displayName": "Bank Movement",
    "description": "A movement of a bank statement, reconciled with Tresoreria (issues/413)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "bank_account": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::bank-account.bank-account"
    },
    "bank_import": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::bank-import.bank-import",
      "inversedBy": "movements"
    },
    "date": {
      "type": "date",
      "required": true
    },
    "value_date": {
      "type": "date"
    },
    "amount": {
      "type": "decimal",
      "required": true
    },
    "concept": {
      "type": "text"
    },
    "reference": {
      "type": "string"
    },
    "document": {
      "type": "string"
    },
    "common_concept": {
      "type": "string"
    },
    "hash": {
      "type": "string",
      "unique": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "matched",
        "ignored"
      ],
      "default": "pending",
      "required": true
    },
    "match_kind": {
      "type": "enumeration",
      "enum": [
        "lines",
        "annotation",
        "expense",
        "transfer"
      ]
    },
    "created_records": {
      "type": "json"
    },
    "transfer_movement": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::bank-movement.bank-movement"
    },
    "rule": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::bank-rule.bank-rule"
    },
    "auto": {
      "type": "boolean",
      "default": false
    },
    "matched_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "matched_at": {
      "type": "datetime"
    },
    "validations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::treasury-validation.treasury-validation",
      "mappedBy": "bank_movement"
    }
  }
}
