{
  "kind": "collectionType",
  "collectionName": "treasury_validations",
  "info": {
    "singularName": "treasury-validation",
    "pluralName": "treasury-validations",
    "displayName": "Treasury Validation",
    "description": "Track validated treasury movements"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "entity_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "emitted-invoices",
        "received-invoices",
        "received-incomes",
        "received-expenses",
        "payrolls",
        "treasuries"
      ]
    },
    "entity_id": {
      "type": "integer",
      "required": true
    },
    "sub_type": {
      "type": "string"
    },
    "validated_by": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "notes": {
      "type": "text"
    },
    "settlement": {
      "type": "json"
    },
    "bank_movement": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::bank-movement.bank-movement",
      "inversedBy": "validations"
    }
  }
}
