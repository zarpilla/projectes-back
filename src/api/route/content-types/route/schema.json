{
  "kind": "collectionType",
  "collectionName": "routes",
  "info": {
    "singularName": "route",
    "pluralName": "routes",
    "displayName": "Route"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "project": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::project.project"
    },
    "monday": {
      "type": "boolean"
    },
    "tuesday": {
      "type": "boolean"
    },
    "wednesday": {
      "type": "boolean"
    },
    "thursday": {
      "type": "boolean"
    },
    "friday": {
      "type": "boolean"
    },
    "saturday": {
      "type": "boolean"
    },
    "sunday": {
      "type": "boolean"
    },
    "short_name": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "order": {
      "type": "integer"
    },
    "route_rates": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::route-rate.route-rate",
      "mappedBy": "routes"
    },
    "pickup": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::pickup.pickup"
    },
    "volume_discount_number_of_orders": {
      "type": "integer"
    },
    "volume_discount_price": {
      "type": "decimal"
    },
    "transfer_pickup": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::pickup.pickup"
    },
    "is_transfer_route": {
      "type": "boolean"
    },
    "is_transfer_route_date": {
      "type": "enumeration",
      "enum": [
        "only_same_day",
        "only_previous_days"
      ]
    },
    "delivery_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    }
  }
