    },
    "address": {
      "type": "string",
      "required": true
    },
    "schedule": {
      "type": "text",
      "required": true
    },
    "estimated_weight": {
      "type": "string"
    },
    "notes": {
      "type": "text"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "answered": {
      "type": "boolean",
      "default": false
    },
    "answered_date": {
      "type": "datetime"
    },
    "answered_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
