{
  "kind": "collectionType",
  "collectionName": "delivery_point_requests",
  "info": {
    "singularName": "delivery-point-request",
    "pluralName": "delivery-point-requests",
    "displayName": "DeliveryPointRequest"
  },
  "options": {
