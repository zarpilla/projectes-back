{
  "kind": "collectionType",
  "collectionName": "incidences",
  "info": {
    "singularName": "incidences",
    "pluralName": "incidenceses",
    "displayName": "Incidences"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "state": {
      "type": "enumeration",
      "enum": ["open", "wip", "closed"]
    },
    "created_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "closed_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "closed_date": {
      "type": "datetime"
    },
    "description": {
      "type": "text"
    },
    "order": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::orders.orders"
    },
    "incidence_response": {
      "type": "component",
      "repeatable": true,
      "component": "orders.incidence-response"
    }
  }
}
