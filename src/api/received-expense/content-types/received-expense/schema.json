{
  "kind": "collectionType",
  "collectionName": "received_expenses",
  "info": {
    "singularName": "received-expense",
    "pluralName": "received-expenses",
    "displayName": "Received Expenses"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "number": {
      "type": "integer"
    },
    "emitted": {
      "type": "date"
    },
    "paybefore": {
      "type": "date"
    },
    "contact": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::contact.contact"
    },
    "total_base": {
      "type": "decimal"
    },
    "total_vat": {
      "type": "decimal"
    },
    "total_irpf": {
      "type": "decimal"
    },
    "total": {
      "type": "decimal"
    },
    "comments": {
      "type": "richtext"
    },
    "paid": {
      "type": "boolean",
      "default": false
    },
    "paid_date": {
      "type": "date"
    },
    "sent": {
      "type": "boolean",
      "default": false
    },
    "sent_date": {
      "type": "date"
    },
    "code": {
      "type": "string",
      "required": false,
      "unique": false
    },
    "serial": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::serie.serie"
    },
    "updatable": {
      "type": "boolean"
    },
    "updatable_admin": {
      "type": "boolean",
      "default": false
    },
    "documents": {
      "type": "media",
      "relation": "oneToMany",
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "payment_method": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::payment-method.payment-method"
    },
    "contact_invoice_number": {
      "type": "string"
    },
    "lines": {
      "type": "component",
      "repeatable": true,
      "component": "invoice-line.ticket-line"
    },
    "document_type": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::document-type.document-type"
    },
    "project": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project",
      "inversedBy": "received_expenses"
    },
    "projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project",
      "inversedBy": "linked_received_expenses"
    },
    "vat_paid_date": {
      "type": "datetime"
    },
    "deductible_vat_pct": {
      "type": "decimal"
    },
    "comments_internal": {
      "type": "richtext"
    },
    "bank_account": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::bank-account.bank-account"
    },
    "contact_info": {
      "type": "component",
      "repeatable": false,
      "component": "contact.contact-data"
    },
    "document_concept": {
      "type": "string"
    }
  }
}
