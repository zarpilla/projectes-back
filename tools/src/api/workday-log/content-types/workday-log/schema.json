{
  "kind": "collectionType",
  "collectionName": "workday_logs",
  "info": {
    "singularName": "workday log",
    "pluralName": "workday logs",
    "displayName": "Workday Log"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
