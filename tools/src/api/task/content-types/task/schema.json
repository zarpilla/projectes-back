{
  "kind": "collectionType",
  "collectionName": "tasks",
  "info": {
    "singularName": "task",
    "pluralName": "tasks",
    "displayName": "Task"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "due_date": {
      "type": "date"
    },
    "task_state": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::task-state.task-state"
    },
    "users_permissions_users": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "inversedBy": "tasks"
    },
    "project": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::project.project"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "activity_type": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::activity-type.activity-type"
    },
    "documents": {
      "type": "media",
      "relation": "oneToMany",
      "allowedTypes": ["images", "files", "videos"]
    },
    "checklist": {
      "type": "component",
      "repeatable": true,
      "component": "task.task-checklist"
    },
    "created": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
