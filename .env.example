# ─────────────────────────────────────────────────────────────────────────────
# projectes-v5 environment variables (EXAMPLE — replace with real values)
# Copy to .env and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Server
HOST=0.0.0.0
PORT=1337
# Set to true when Strapi runs behind a reverse proxy (nginx) terminating TLS,
# so Koa trusts X-Forwarded-Proto. Required in production or login returns 500.
IS_PROXIED=false
URL=http://localhost:1337

# Secrets — generate with: openssl rand -base64 32  (APP_KEYS: 3-4 comma-separated)
APP_KEYS="replace-me-base64,replace-me-base64,replace-me-base64"
API_TOKEN_SALT=replace-me-base64
ADMIN_JWT_SECRET=replace-me-base64
JWT_SECRET=replace-me-base64
TRANSFER_TOKEN_SALT=replace-me-base64
ENCRYPTION_KEY=replace-me-base64

# Database (MySQL). Per-process pool caps matter under PM2 multi-tenant:
# 16 instances x POOL_MAX must stay under MySQL max_connections (151).
DATABASE_CLIENT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=projectes_v5_dev
DATABASE_USERNAME=admin
DATABASE_PASSWORD=replace-me
DATABASE_SSL=false
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=8

# ── Email ───────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER switches the active provider: "sendgrid" | "nodemailer"
EMAIL_PROVIDER=nodemailer
EMAIL_FROM="Projectes <noreply@example.com>"

# SendGrid (used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=replace-me

# Nodemailer / SMTP (used when EMAIL_PROVIDER=nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=replace-me
SMTP_PASS=replace-me

# Daily task digest cron destination
TASK_EMAIL_TO=replace-me@example.com

# ── FACe (Spanish gov e-invoice) ────────────────────────────────────────────
FACE_TEST_ENDPOINT=https://se-face-webservice.redsara.es/facturasspp
FACE_REAL_ENDPOINT=https://webservice.face.gob.es/facturasspp
FACE_XSD_TIMEOUT_MS=30000
FACE_DRY_RUN=true

# ── DIR3 registry proxy ─────────────────────────────────────────────────────
DIR3_API_URL=https://dir3.example.com
DIR3_API_KEY=replace-me

# ── Invoice parser (LLM) proxy ──────────────────────────────────────────────
INVOICE_PARSER_API_URL=https://invoice-parser.example.com
ZAI_API_KEY=replace-me

# ── Google Calendar sync (service account) ──────────────────────────────────
# Path to the service-account JSON on disk (absolute or relative to project root)
GOOGLE_APPLICATION_CREDENTIALS=

# ── Logging (PM2 / Loki) ────────────────────────────────────────────────────
STRAPI_LOG_LEVEL=http
STRAPI_LOG_TIMESTAMP=true
STRAPI_LOG_PRETTY_PRINT=false

# 32-byte key (hex or base64) used to encrypt stored secrets at rest:
# certificate passphrases and integration API keys. See src/services/secret-crypto.js.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the key is derived from APP_KEYS — works, but then rotating APP_KEYS
# makes every stored secret unreadable. Set this explicitly in production.
SECRETS_KEY=
