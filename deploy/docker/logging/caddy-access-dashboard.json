    {
      "type": "table",
      "title": "Slowest endpoints (p95)",
      "description": "Over the selected time range. Path = URI without query string; numeric ids → :id, documentIds → :docId.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {job=\"caddy\", instance=~\"$instance\"} | json method=\"request.method\", uri=\"request.uri\", duration, size, status | label_format path=`{{ regexReplaceAll \"/[0-9]+\\\\b\" (regexReplaceAll \"/[a-z0-9]{24}\\\\b\" (regexReplaceAll \"^/uploads/.*\" (regexReplaceAll \"\\\\?.*\" .uri \"\") \"/uploads/*\") \"/:docId\") \"/:id\" }}` | unwrap duration | __error__=\"\" [$__range]) by (instance, method, path)",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max_over_time({job=\"caddy\", instance=~\"$instance\"} | json method=\"request.method\", uri=\"request.uri\", duration, size, status | label_format path=`{{ regexReplaceAll \"/[0-9]+\\\\b\" (regexReplaceAll \"/[a-z0-9]{24}\\\\b\" (regexReplaceAll \"^/uploads/.*\" (regexReplaceAll \"\\\\?.*\" .uri \"\") \"/uploads/*\") \"/:docId\") \"/:id\" }}` | unwrap duration | __error__=\"\" [$__range]) by (instance, method, path)",
          "queryType": "instant"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (instance, method, path) (count_over_time({job=\"caddy\", instance=~\"$instance\"} | json method=\"request.method\", uri=\"request.uri\", duration, size, status | label_format path=`{{ regexReplaceAll \"/[0-9]+\\\\b\" (regexReplaceAll \"/[a-z0-9]{24}\\\\b\" (regexReplaceAll \"^/uploads/.*\" (regexReplaceAll \"\\\\?.*\" .uri \"\") \"/uploads/*\") \"/:docId\") \"/:id\" }}` | __error__=\"\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "p95 duration",
              "Value #B": "max duration",
              "Value #C": "requests",
              "Value #D": "max size",
              "Value #E": "p95 size"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "p95 duration",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "limit",
          "options": {
            "limitField": 30
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95 duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max duration"
            },
            "properties": [
              {
